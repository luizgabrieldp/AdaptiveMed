# ==============================================================================
# AdaptiveMed - Configurações de Ambiente (Vercel & Supabase Free Tier)
# ==============================================================================

# URL canônica pública da aplicação (usada em SEO, Sitemap, OpenGraph, JSON-LD e Stripe)
# Quando migrar para domínio próprio, atualize apenas esta variável (sem barra no final).
NEXT_PUBLIC_SITE_URL=https://adaptive-med.vercel.app

# E-mail público de suporte (opcional; exibido em JSON-LD Organization e páginas legais se definido)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Obtenha estas chaves no painel do seu projeto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
